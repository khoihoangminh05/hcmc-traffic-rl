REDIS_URL=redis://localhost:6379
PORT=3000
DATA_RAW_DIR=./data_raw
STATE_DIR=./state

# Mapbox — gentle polling (avoid rate limits)
MAPBOX_ACCESS_TOKEN=
MAPBOX_POLL_INTERVAL_MS=900000
MAPBOX_BATCH_SIZE=15
MAPBOX_REQUEST_DELAY_MS=1500
MAPBOX_OD_FILE=./config/od_pairs.quan4.seeds.json
MAPBOX_OD_PAIRS=[]
# Set to 1 only if you intentionally want POST /mapbox/poll to sweep ALL seeds
MAPBOX_MANUAL_FULL=0

# HCMC cameras
CAMERA_CATALOG_FILE=./config/cameras.hcmc_seed.json
CAMERA_HLS_SOURCES=[]
CAMERA_SEGMENT_LIMIT=30
