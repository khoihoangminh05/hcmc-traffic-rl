# Empty REDIS_URL= turns Redis off (sol1 runs only the probes).
REDIS_URL=redis://localhost:6379
PORT=3000
DATA_RAW_DIR=./data_raw
STATE_DIR=./state

# Mapbox — gentle polling (avoid rate limits)
MAPBOX_ACCESS_TOKEN=
MAPBOX_POLL_INTERVAL_MS=900000
MAPBOX_BATCH_SIZE=15
MAPBOX_REQUEST_DELAY_MS=1500
MAPBOX_OD_FILE=./config/od_pairs.quan4.seeds.json
MAPBOX_OD_PAIRS=[]
# Set to 1 only if you intentionally want POST /mapbox/poll to sweep ALL seeds
MAPBOX_MANUAL_FULL=0

# Mapbox long-route traffic probes (v4). Empty file = off.
# Routes: python -m data_fusion.design_probe_routes (ml-core). 100 routes x 56 sweeps/day (15 min) = 78k per 14 days; the cap counts live + typical together.
# Typical traffic (depart_at, future days): POST /mapbox/probe/typical?start=YYYY-MM-DD&days=7&stepMin=15
# To stop the old single-edge seed poller, set MAPBOX_OD_FILE= and MAPBOX_OD_PAIRS=[] above.
MAPBOX_PROBE_FILE=./config/probe_routes.quan4.json
MAPBOX_PROBE_PROFILE=driving-traffic
MAPBOX_PROBE_INTERVAL_MS=900000
MAPBOX_PROBE_DELAY_MS=1200
MAPBOX_TYPICAL_DELAY_MS=300
# Vietnam local hours [start, end)
MAPBOX_PROBE_HOURS=6-20
MAPBOX_PROBE_MONTHLY_CAP=95000

# HCMC cameras
CAMERA_CATALOG_FILE=./config/cameras.hcmc_seed.json
CAMERA_HLS_SOURCES=[]
CAMERA_SEGMENT_LIMIT=30
